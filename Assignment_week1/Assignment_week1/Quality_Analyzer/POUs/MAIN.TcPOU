  <POU Name="MAIN" Id="{864c6c48-a6ed-4662-b6a7-4e5a364ffb3e}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN

//aProductArray : ARRAY[1..20] OF REAL := [23,120,85,100,250,489.95,489.96,230,190,30,10,600,240,210,10000,8600,61,349.444,42.252,534.2];
VAR
aActualProductArray : ARRAY[1..GVL.nMaximumSizeOfArray] OF REAL;
aCopyOfProductArray : ARRAY[1..GVL.nMaximumSizeOfArray] OF REAL;
stProductAnalysis : ST_ProductStats;
	bRun: BOOL:= TRUE;
	nBase : INT ;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bRun THEN
	RandomArrayGenerator(aActualProductArray,nBase);
	aCopyOfProductArray := aActualProductArray;
	stProductAnalysis := AnalyzeBatch(aCopyOfProductArray);
	bRun := FALSE;
END_IF
]]></ST>
    </Implementation>
