          "false": [
            {
              "objectType": "WriteToSymbol",
              "active": true,
              "symbolExpression": "%tp%BoolParameter%/tp%",
              "valueType": "tchmi:general#/definitions/BOOL",
              "value": {
                "objectType": "StaticValue",
                "valueType": "tchmi:general#/definitions/BOOL",
                "value": true
              },
              "asyncWait": true
            }
          ],
          "asyncWait": true
        }
      ],
      "parameters": [
        {
