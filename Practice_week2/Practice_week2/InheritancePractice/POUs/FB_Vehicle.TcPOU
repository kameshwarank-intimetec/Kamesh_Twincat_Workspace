  <POU Name="FB_Vehicle" Id="{fdce45e9-053d-4216-8e52-03f7b816add1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Vehicle

VAR
	bRunning : BOOL;
	fFuelKilometerLimit : REAL;
	bMoving : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="DriveMode" Id="{c80c79b6-3172-400f-8310-f1a6f829c893}">
      <Declaration><![CDATA[METHOD DriveMode : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bMoving THEN
	bMoving := FALSE;
	ELSE
	bMoving := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Feuling" Id="{f82595bb-a993-4b3b-83cf-4f1c16adc682}">
