    </Method>
    <Method Name="Start" Id="{3938cef0-d2e3-43c3-8602-94c4ecbaecea}">
      <Declaration><![CDATA[METHOD Start : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRunning := TRUE;
Start := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{13197267-6a36-4b1e-807f-7bb9f08182f4}">
      <Declaration><![CDATA[METHOD Stop : BOOL
