END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[TurningOnTheValveIfValveIsEmpty();]]></ST>
    </Implementation>
    <Method Name="SettingThePressure" Id="{c9e7dafd-786c-4278-98e3-3c594573f1e3}">
