    <Method Name="TurningOnTheValveIfValveIsEmpty" Id="{4769dfd1-bd24-40b1-a8cd-ee27c407d8a7}">
      <Declaration><![CDATA[METHOD TurningOnTheValveIfValveIsEmpty
VAR_INPUT
END_VAR
VAR
	fbBottleFiller : FB_BottleFiller;
	fbBottle : FB_BottleFiller;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TurningOnTheValveIfValveIsEmpty');

fbBottleFiller.StartFilling();
AssertTrue(Condition := fbBottleFiller.bFilling,
		   Message := 'Tank is not Empty');

fbBottleFiller.bisTankEmpty := TRUE;
fbBottleFiller.StartFilling();

AssertFalse(Condition := fbBottleFiller.bFilling, 
			 Message := 'Tank is filling');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
