  <POU Name="FB_BottleFiller_Test" Id="{ee18a254-76ee-4cdc-a982-a7ec347d4bf4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_BottleFiller_Test EXTENDS FB_TestSuite

