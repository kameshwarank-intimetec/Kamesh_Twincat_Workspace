<div id="Storage_Rack" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControl" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-width="70" data-tchmi-height="70" data-tchmi-width-unit="px" data-tchmi-height-unit="px" data-tchmi-creator-viewport-width="500" data-tchmi-creator-viewport-height="500">

<div id="TcHmiTextblock_40" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-height="50" data-tchmi-height-unit="px" data-tchmi-left="10" data-tchmi-left-unit="px" data-tchmi-top="10" data-tchmi-top-unit="px" data-tchmi-width="50" data-tchmi-width-unit="px" data-tchmi-word-wrap="True" data-tchmi-text-horizontal-alignment="Center" data-tchmi-text-vertical-alignment="Center" data-tchmi-text-font-size="18" data-tchmi-text="%pp%Parcel_ID%/pp%" data-tchmi-border-color="%f%SlotStatusConverter(%pp%Rack_State%/pp%)%/f%">




<script data-tchmi-target-attribute="data-tchmi-border-width" type="application/json">
{
  "left": 2,
  "right": 2,
  "top": 2,
  "bottom": 2,
  "leftUnit": "px",
  "rightUnit": "px",
  "topUnit": "px",
  "bottomUnit": "px"
}
</script>

<script data-tchmi-target-attribute="data-tchmi-border-style" type="application/json">
{
  "left": "Solid",
  "right": "Solid",
  "top": "Solid",
  "bottom": "Solid"
}
</script>





<script data-tchmi-target-attribute="data-tchmi-text-color" type="application/json">
{
  "color": "rgba(0, 0, 0, 1)"
}
</script>







<script data-tchmi-target-attribute="data-tchmi-transform" type="application/json">
[
  {
    "transformType": "Translate",
    "x": 0,
    "y": 0,
    "xUnit": "px",
    "yUnit": "px",
    "zUnit": "px"
  }
]
</script>

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "TcHmiTextblock_40.onMouseMove",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%TcHmiTextblock_40::Transform[0]%/ctrl%",
        "valueType": "tchmi:framework#/definitions/TransformList/definitions/transform",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:framework#/definitions/TransformList/definitions/transform",
          "value": {
            "transformType": "Translate",
            "x": 0.0,
            "xUnit": "px",
            "y": -3.0,
            "yUnit": "px",
            "z": 0.0,
            "zUnit": "px"
          }
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": false,
        "symbolExpression": "%ctrl%TcHmiTextblock_40::BoxShadow[0]::blur%/ctrl%",
        "valueType": "tchmi:framework#/definitions/MeasurementValue",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:framework#/definitions/MeasurementValue",
          "value": 5.0
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": false,
        "symbolExpression": "%ctrl%TcHmiTextblock_40::BoxShadow[0]::color::color%/ctrl%",
        "valueType": "string",
        "value": {
          "objectType": "FunctionExpression",
          "functionExpression": "SlotStatusConverter(%pp%Rack_State%/pp%)"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": false,
        "symbolExpression": "%ctrl%TcHmiTextblock_40::BoxShadow[0]::spread%/ctrl%",
        "valueType": "tchmi:framework#/definitions/MeasurementValue",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:framework#/definitions/MeasurementValue",
          "value": 7.0
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": false,
        "symbolExpression": "%ctrl%TcHmiTextblock_40::BoxShadow[0]::blurUnit%/ctrl%",
        "valueType": "tchmi:framework#/definitions/PixelUnit",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:framework#/definitions/PixelUnit",
          "value": "px"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": false,
        "symbolExpression": "%ctrl%TcHmiTextblock_40::BoxShadow[0]::spreadUnit%/ctrl%",
        "valueType": "tchmi:framework#/definitions/PixelUnit",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:framework#/definitions/PixelUnit",
          "value": "px"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": false,
        "symbolExpression": null,
        "valueType": "tchmi:general#/definitions/String",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/String",
          "value": ""
        },
        "asyncWait": true
      }
    ]
  },
  {
    "event": "TcHmiTextblock_40.onMouseOut",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%TcHmiTextblock_40::Transform[0]%/ctrl%",
        "valueType": "tchmi:framework#/definitions/TransformList/definitions/transform",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:framework#/definitions/TransformList/definitions/transform",
          "value": {
            "transformType": "Translate",
            "x": 0.0,
            "xUnit": "px",
            "y": 0.0,
            "yUnit": "px",
            "z": 0.0,
            "zUnit": "px"
          }
        },
        "asyncWait": true
      }
    ]
  }
]</script>

<script data-tchmi-target-attribute="data-tchmi-box-shadow" type="application/json">
[
  {
    "color": "%f%SlotStatusConverter(%pp%Rack_State%/pp%)%/f%",
    "offsetX": 0.0,
    "offsetXUnit": "px",
    "offsetY": 0.0,
    "offsetYUnit": "px",
    "inset": false,
    "blur": 7.0,
    "blurUnit": "px",
    "spread": 2.0,
    "spreadUnit": "px"
  }
]
</script>
</div>

</div>