<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <DUT Name="E_CraneState" Id="{05e9afc7-510b-4439-a9a0-1c745ad96aa1}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_CraneState :
(
    IDLE            := 0,   // Waiting for a command from the Manager
    
    (* Standard Storage Cycle *)
    MOVING_TO_PICK  := 1,   // Traveling to the Aisle Conveyor station
    PICKING         := 2,   // Extending forks and lifting the parcel
    MOVING_TO_PLACE := 3,   // Traveling to the target Rack [Col, Row]
    PLACING         := 4,   // Extending forks and dropping the parcel
    
    (* Double-Deep Shuffle Sequence *)
    SHUFFLE_START   := 10,  // Identifying if a front box blocks a rear target
    SHUFFLE_PICK    := 11,  // Picking the "blocking" box
    SHUFFLE_MOVE    := 12,  // Moving blocking box to temporary buffer slot
    SHUFFLE_PLACE   := 13,  // Dropping blocking box before finishing original task
    
    (* Recovery & Safety *)
    RETURNING_HOME  := 20,  // Moving to [0,0] for calibration or after Reset
    FAULT           := 99   // Emergency Stop or mechanical timeout
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>