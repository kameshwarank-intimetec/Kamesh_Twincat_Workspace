<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <DUT Name="E_SlotStatus" Id="{556070d3-f6d0-4472-bbaa-8ebecfb18432}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_SlotStatus :
(
    EMPTY           := 0,   // Slot is clear and available
    
    RESERVED_IN     := 1,   // Inbound Manager has claimed this for a box on the loop
    
    OCCUPIED        := 2,   // Box is physically present in the rack
    
    RESERVED_OUT    := 3,   // Retrieval request active; Crane is on the way to pick
    
    BLOCKED         := 4,   // Maintenance mode: Slot is physically broken or restricted
    
    SHUFFLE_LOCKED  := 5    // Double-Deep logic: This slot is being moved to reach the one behind
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>