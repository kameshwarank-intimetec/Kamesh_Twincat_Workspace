<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <DUT Name="ST_Parcel" Id="{fedd5bad-befe-434b-a633-22b4d21cf8cb}">
    <Declaration><![CDATA[TYPE ST_Parcel :
STRUCT
    (* Identification *)
    sID             : STRING(20);   // Unique Barcode/Serial Number
    sDescription    : STRING(40);   // Item name (e.g., "Motor Parts")
    
    (* Physical Properties *)
    fWeight         : REAL;         // Measured at Infeed (Used for Aisle routing)
    fWidth          : REAL;         // mm
    fHeight         : REAL;         // mm
    
    (* System Metadata *)
    dtEntryTime     : DT;           // Timestamp when it entered the warehouse
    
    (* Destination Tracking *)
    nTargetAisle    : INT;          // Calculated by Inbound Manager (1 or 2)
    bIsHeavy        : BOOL;         // Flag for Aisle 2 routing (>100kg)
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>