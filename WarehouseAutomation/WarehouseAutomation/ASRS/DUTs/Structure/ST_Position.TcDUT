<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <DUT Name="ST_Position" Id="{c3149a51-2378-4739-8c9d-810bb7f7f930}">
    <Declaration><![CDATA[TYPE ST_Position :
STRUCT
    (* Array Indices (Logic) *)
    nCol            : INT;   // 1 to 10 (Column Index)
    nRow            : INT;   // 1 to 4 (Row Index)
    nDepth          : INT;   // 1 = Front, 2 = Rear (Double-Deep)
    
    (* Physical Coordinates (Motion) *)
    fTargetX        : LREAL; // Calculated Horizontal Position (mm)
    fTargetY        : LREAL; // Calculated Vertical Position (mm)
    
    (* Orientation *)
    bIsAisleStation : BOOL;  // TRUE if target is the Pick Point, FALSE if Rack
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>