<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <DUT Name="ST_StorageSlot" Id="{8c5b9e40-0bdf-4706-a4ad-2bd3ae991ab3}">
    <Declaration><![CDATA[TYPE ST_StorageSlot :
STRUCT
    (* Occupancy Status *)
    eStatus         : E_SlotStatus; // IDLE, RESERVED, OCCUPIED, BLOCKED
    
    (* The Contents *)
    stParcel        : ST_Parcel;    // The actual box data (DNA)

    (* Physical Configuration *)
    bIsDeepSlot     : BOOL;         // TRUE = Rear Position, FALSE = Front Position
    nPartnerIndex   : INT;          // The index of the slot in front/behind this one
    
    (* Maintenance & Logic *)
    bMaintenance    : BOOL;         // Set to TRUE if the rack shelf is broken
  
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>