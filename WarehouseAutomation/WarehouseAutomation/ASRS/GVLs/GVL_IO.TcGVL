<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <GVL Name="GVL_IO" Id="{188d908f-b3e5-47c1-a697-e6e007a07ac5}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // --- Entry Point ---
    bInfeedSensor           : BOOL; // Box detected at start
    bInfeedBlocker          : BOOL; // Stop/Release at entry
    
    // --- Main Loop Junctions ---
    // Aisle 1 - Small Parcels
    bAisle1ApproachSensor   : BOOL; // Detect box coming to Aisle 1
    bAisle1StopBlocker      : BOOL; // Physical pin to center the box
    bAisle1RatLift          : BOOL; // Raise transfer chains
    bAisle1RatTravel        : BOOL; // Move box into Aisle 1
    
    // Aisle 2 - Heavy Parcels
    bAisle2ApproachSensor   : BOOL; // Detect box coming to Aisle 2
    bAisle2StopBlocker      : BOOL; // Physical pin to center the box
    bAisle2RatLift          : BOOL; // Raise transfer chains
    bAisle2RatTravel        : BOOL; // Move box into Aisle 2
    
    // Outfeed Junction
    bOutfeedApproachSensor  : BOOL; 
    bOutfeedStopBlocker     : BOOL; 
    bOutfeedRatLift         : BOOL; 
    bOutfeedRatTravel       : BOOL; 
    
    // --- Aisle Conveyors ---
    bAisle1EntrySensor      : BOOL; // Box has successfully turned into Aisle 1
    bAisle1CraneStation     : BOOL; // Box is at the Crane 1 pick point
    bAisle1MotorForward     : BOOL; 
    bAisle1MotorReverse     : BOOL; 
    
    bAisle2EntrySensor      : BOOL; // Box has successfully turned into Aisle 2
    bAisle2CraneStation     : BOOL; // Box is at the Crane 2 pick point
    bAisle2MotorForward     : BOOL; 
    bAisle2MotorReverse     : BOOL; 
    
    // --- Exit ---
    bExitDockSensor         : BOOL; // Box reached final destination
    bExitMotor              : BOOL; 
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>