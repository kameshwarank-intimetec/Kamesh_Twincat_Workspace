<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <GVL Name="GVL_Warehouse" Id="{7912caad-9423-41dd-9258-18bbbf3fb6ef}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL PERSISTENT
    (* The Master Rack Matrix: [1..10 Columns, 1..4 Rows] *)
    // Total 40 Slots. Each slot contains its status and parcel DNA.
    arrRack : ARRAY[1..GVL_Config.MAX_COLUMNS, 1..GVL_Config.MAX_ROWS] OF ST_StorageSlot;
    
    (* Life Cycle Statistics (Saved across power cycles) *)
    nTotalStoredCount    : UDINT; // Total boxes processed since project start
    nTotalRetrievedCount : UDINT; // Total boxes sent out to the dock
    
    (* System Metadata *)
    sWarehouseName      : STRING := 'IntimeTec_ASRS_01';
    bInventoryInitialized : BOOL := FALSE; // Flag to run the first-time setup
END_VAR

VAR_GLOBAL
    (* Real-time Status (Reset on power off) *)
    bSystemAutoMode     : BOOL := FALSE;
    bEmergencyStopActive : BOOL := FALSE;
    sSystemStatusMsg    : STRING(80) := 'System Ready'; // For HMI Header
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>