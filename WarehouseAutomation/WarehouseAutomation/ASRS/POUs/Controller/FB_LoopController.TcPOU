<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_LoopController" Id="{f48adaf0-df81-44d4-869d-09b0da41d4aa}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LoopController
VAR_INPUT
    bEnable             : BOOL;    // System Master Enable
    bReset              : BOOL;    // Manual Fault Reset
    
    // Routing Information (From Warehouse Manager)
    nTargetAisle        : INT;     // 1 = Aisle 1, 2 = Aisle 2, 3 = Outfeed
END_VAR

VAR_OUTPUT
    bLoopReady          : BOOL;    // Tells InFeed if there is space
    bError              : BOOL;    
END_VAR

VAR
    // The "Muscles" (Entities) owned by the Loop
    fbMainLoopBelt      : FB_Conveyor; 
    fbAisle1Rat         : FB_RAT;      
    fbAisle2Rat         : FB_RAT;
    fbOutfeedRat        : FB_RAT;

    // Traffic State Machine
    nState              : INT := 0; 
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 1. Update all Entities (The Muscles)
// Main Loop Belt (Always running if enabled)
fbMainLoopBelt(
    bEnable := bEnable, 
    bReset := bReset, 
);

// Update RATs with their specific GVL Sensors/Actuators
fbAisle1Rat(bEnable:= bEnable, bReset:= bReset, bSensorOccupied:= GVL_IO.bRat1Sensor, 
            bSensorIsUp:= GVL_IO.bRat1Up, bSensorIsDown:= GVL_IO.bRat1Down);

fbAisle2Rat(bEnable:= bEnable, bReset:= bReset, bSensorOccupied:= GVL_IO.bRat2Sensor, 
            bSensorIsUp:= GVL_IO.bRat2Up, bSensorIsDown:= GVL_IO.bRat2Down);

// 2. Traffic Routing Logic
CASE nState OF
    
    0: // MONITORING: Main belt is running, waiting for a box at a junction
        bLoopReady := NOT GVL_IO.bLoopSensor; // Space available if loop sensor is clear
        
        // CHECK AISLE 1 JUNCTION
        IF GVL_IO.bRat1Sensor AND nTargetAisle = 1 THEN
            nState := 10; // Divert to Aisle 1
        
        // CHECK AISLE 2 JUNCTION
        ELSIF GVL_IO.bRat2Sensor AND nTargetAisle = 2 THEN
            nState := 20; // Divert to Aisle 2
        END_IF

    10: // DIVERTING TO AISLE 1
        fbAisle1Rat.M_Divert(bOpen := TRUE);
        
        // Transition: Once the RAT finishes its 3-step sequence and returns to IDLE
        IF fbAisle1Rat.eStatus = E_DiverterState.IDLE THEN
            nState := 0; 
        END_IF

    20: // DIVERTING TO AISLE 2
        fbAisle2Rat.M_Divert(bOpen := TRUE);
        
        IF fbAisle2Rat.eStatus = E_DiverterState.IDLE THEN
            nState := 0;
        END_IF

    99: // FAULT
        bError := fbMainLoopBelt.bError OR fbAisle1Rat.bError OR fbAisle2Rat.bError;
        IF bReset THEN nState := 0; END_IF

END_CASE]]></ST>
    </Implementation>
    <LineIds Name="FB_LoopController">
      <LineId Id="40" Count="4" />
      <LineId Id="48" Count="42" />
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>