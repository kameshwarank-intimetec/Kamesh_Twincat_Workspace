<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_OutFeedController" Id="{92429ae1-de73-4d9b-b929-da1182fa1b53}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_OutFeedController
VAR_INPUT
    bEnable             : BOOL;    // System Master Enable
    bReset              : BOOL;    // Global Reset
    bOutFeedRequest     : BOOL;    // Handshake: Loop wants to send a box out
END_VAR

VAR_OUTPUT
    bOutFeedBusy        : BOOL;    // Signaling to WarehouseManager
    bError              : BOOL;    // Global Error
END_VAR

VAR
    // THE MUSCLE: Standard Conveyor for the exit path
    fbOutFeedConveyor   : FB_Conveyor;
    
    // Internal State for the Process (Mirrored from Infeed)
    nState  : (WAITING_FOR_PARCEL, RECEIVING_FROM_LOOP, TRANSFERRING, WAITING_FOR_CLEAR, FAULT); 
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 1. Update the Muscle Entity
fbOutFeedConveyor();

// 2. The OutFeed Process Brain
CASE nState OF
    
    WAITING_FOR_PARCEL: // IDLE: Waiting for a parcel to arrive from the Loop
        bOutFeedBusy := FALSE;
        // If the Loop Controller has a box ready for the exit RAT
        IF bOutFeedRequest THEN
            nState := RECEIVING_FROM_LOOP;
        END_IF

    RECEIVING_FROM_LOOP: // The RAT is pushing the box onto the Outfeed belt
        bOutFeedBusy := TRUE;
        fbOutFeedConveyor.M_Run(bForward := TRUE);
        
        // If the box hits the OutFeed entrance sensor
        IF GVL_IO.bOutFeedSensor THEN
            nState := TRANSFERRING;
        END_IF

    TRANSFERRING: // Moving the box toward the final exit point
        fbOutFeedConveyor.M_Run(bForward := TRUE);
        
        // If the box has cleared the exit sensor (Parcel has left the system)
        IF NOT GVL_IO.bOutFeedSensor THEN
            fbOutFeedConveyor.M_Stop();
            nState := WAITING_FOR_CLEAR;
        END_IF

    WAITING_FOR_CLEAR: // Ensuring the path is clear before next box
        IF NOT GVL_IO.bOutFeedSensor THEN
            nState := WAITING_FOR_PARCEL;
        END_IF

    FAULT: // ERROR HANDLING
        bError := fbOutFeedConveyor.bError;
        IF bReset THEN
            nState := WAITING_FOR_PARCEL; 
        END_IF

END_CASE]]></ST>
    </Implementation>
    <LineIds Name="FB_OutFeedController">
      <LineId Id="35" Count="41" />
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>