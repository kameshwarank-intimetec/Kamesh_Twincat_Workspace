<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_BiDirectionConveyor" Id="{82de352f-fae1-461d-8e99-3962df4892ff}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_BiDirectionConveyor EXTENDS FB_Conveyor
VAR_INPUT
    bSensorAisleEntry   : BOOL;    // Physical Sensor at the Loop Junction
END_VAR

VAR_OUTPUT
    bMotorReverse       : BOOL;    // Physical Output for Reverse direction
END_VAR

VAR
    // No new internal timers needed yet, as we reuse the Parent's JamTimer
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 1. Run the Parent Logic (Handles Enable, Reset, and Forward Jamming)
SUPER^();

// 2. Specific Logic for Reverse/Waiting states
CASE eConveyorMode OF
    
    E_ConveyorMode.IDLE:
        bMotorReverse := FALSE;
        // bMotorRun is already handled by the Parent IDLE state

    E_ConveyorMode.TRANSPORT_TO_LOOP:
        bMotorRun     := TRUE;   // Turn on power
        bMotorReverse := TRUE;   // Set direction to Reverse
        
        // Transition: Stop when the box reaches the Loop junction sensor
        IF bSensorAisleEntry THEN
            eConveyorMode := E_ConveyorMode.WAITING_FOR_LOOP;
        END_IF

    E_ConveyorMode.WAITING_FOR_LOOP:
        bMotorRun     := FALSE;
        bMotorReverse := FALSE;

    E_ConveyorMode.FAULT:
        bMotorReverse := FALSE;
        // bMotorRun is already set to FALSE by the Parent FAULT state

END_CASE]]></ST>
    </Implementation>
    <Method Name="M_Run" Id="{9fa79b56-5384-4ec4-a8a5-f6e5246fc03d}">
      <Declaration><![CDATA[METHOD M_Run : BOOL
VAR_INPUT
	bForward : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// Only allow starting if not in Fault
IF eConveyorMode <> E_ConveyorMode.FAULT AND bEnable THEN
    
    IF bForward THEN
        eConveyorMode := E_ConveyorMode.TRANSPORT_TO_CRANE;
    ELSE
        eConveyorMode := E_ConveyorMode.TRANSPORT_TO_LOOP;
    END_IF
    
    M_Run := TRUE;
ELSE
    M_Run := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_BiDirectionConveyor">
      <LineId Id="28" Count="26" />
      <LineId Id="9" Count="0" />
    </LineIds>
    <LineIds Name="FB_BiDirectionConveyor.M_Run">
      <LineId Id="11" Count="12" />
      <LineId Id="6" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>