<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_Crane" Id="{4b8f548e-7a10-4e7e-bf02-3e2058259e29}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Crane IMPLEMENTS I_Crane
VAR_INPUT
    bEnable             : BOOL;    // Master Safety Enable
    bReset              : BOOL;    // Manual Fault Reset
    
    // Physical Position Feedback
    fCurrentPosX        : LREAL;   // Actual X position (mm)
    fCurrentPosY        : LREAL;   // Actual Y position (mm)
    
    // Physical Fork Sensors
    bForksHome          : BOOL;    // Sensors: Center position
    bForksExtended      : BOOL;    // Sensors: Fully out
END_VAR

VAR_OUTPUT
    bError              : BOOL;    // Mechanical or Timeout Fault
    eStatus             : E_CraneState := E_CraneState.IDLE;
END_VAR

VAR
    // Target Coordinates (Mapped from ST_Pos)
    stTargetPos         : ST_Position;
    
    // Internal Physical Commands
    bMotorRunX          : BOOL;
    bMotorRunY          : BOOL;
    bForksOut           : BOOL;
    
    // Safety Timers
    fbMotionTimeout     : TON;     
    fbForkTimeout       : TON;     
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 1. Safety & Reset Handling
IF NOT bEnable THEN
    bMotorRunX := bMotorRunY := bForksOut := FALSE;
    eStatus := E_CraneState.IDLE;
ELSIF bReset THEN
    bError := FALSE;
    eStatus := E_CraneState.IDLE;
END_IF

// 2. The Crane State Machine (Using your EXACT E_CraneState)
CASE eStatus OF
    
    E_CraneState.IDLE:
        bMotorRunX := bMotorRunY := bForksOut := FALSE;

    E_CraneState.MOVING_TO_PICK:
        bMotorRunX := TRUE;
        bMotorRunY := TRUE;
        // Condition: Reach the Aisle Station (0,0)
        IF ABS(fCurrentPosX - stTargetPos.fTargetX) < 5.0 AND 
           ABS(fCurrentPosY - stTargetPos.fTargetY) < 5.0 THEN
            eStatus := E_CraneState.PICKING;
        END_IF

    E_CraneState.PICKING:
        bMotorRunX := bMotorRunY := FALSE; // Hold position
        bForksOut := TRUE; 
        // Condition: Forks reached the box
        IF bForksExtended THEN
            eStatus := E_CraneState.MOVING_TO_PLACE;
        END_IF

    E_CraneState.MOVING_TO_PLACE:
        bForksOut := FALSE; // Retract while moving (Standard logic)
        IF bForksHome THEN
            bMotorRunX := TRUE;
            bMotorRunY := TRUE;
        END_IF
        // Condition: Reach the Rack Slot [Col, Row]
        IF ABS(fCurrentPosX - stTargetPos.fTargetX) < 5.0 AND 
           ABS(fCurrentPosY - stTargetPos.fTargetY) < 5.0 THEN
            eStatus := E_CraneState.PLACING;
        END_IF

    E_CraneState.PLACING:
        bMotorRunX := bMotorRunY := FALSE;
        bForksOut := TRUE;
        IF bForksExtended THEN
             eStatus := E_CraneState.IDLE; // Cycle Complete
        END_IF

    E_CraneState.FAULT:
        bMotorRunX := bMotorRunY := bForksOut := FALSE;
        bError := TRUE;

END_CASE

// 3. Safety Monitoring
fbMotionTimeout(IN := (bMotorRunX OR bMotorRunY), PT := T#30S);
IF fbMotionTimeout.Q THEN eStatus := E_CraneState.FAULT; END_IF]]></ST>
    </Implementation>
